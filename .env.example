# Copy to .env. Never commit .env.

# Used by the application (TrackingConfig::fromEnv()).
DHL_TRACKING_API_KEY=
# production (default) or sandbox
DHL_TRACKING_ENVIRONMENT=production
DHL_TRACKING_LANGUAGE=en

# Used only by the sandbox tests (composer test:sandbox). They always call https://api-sandbox.dhl.com.
DHL_SANDBOX_API_KEY=
# Comma separated tracking numbers to try in the sandbox (default: the example number from the API spec).
DHL_SANDBOX_TRACKING_NUMBERS=
